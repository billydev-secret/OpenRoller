# RiskyRollaBot configuration.
#
# Copy this file to .env (same directory you start the bot from) and fill in
# DISCORD_TOKEN. Everything else is optional; a line starting with # is a
# comment, and a commented-out setting keeps its default. Do not quote values.
#
# The same file works as a systemd EnvironmentFile and a Docker Compose
# env_file, so one copy serves every way of running the bot.

# ---------------------------------------------------------------- required --

# Bot token. Developer Portal -> your application -> Bot -> "Reset Token".
# Paste it raw: no quotes, no "Bot " prefix. Never commit your .env.
DISCORD_TOKEN=

# ------------------------------------------------------------------- state --

# SQLite file holding open rounds, pending prompts and per-server settings.
# A relative path is resolved from the directory the bot is started in.
#STATE_DB_PATH=riskyroller.sqlite3

# ------------------------------------------------------ slash-command sync --

# Register the slash commands with Discord globally on every start.
# Accepts 1/true/yes/on (anything else is false). Default: true.
# Global registration can take up to an hour to show up in Discord. Once the
# commands are registered you may turn this off; each sync counts against
# Discord's rate limits, which matters if you restart often.
#SYNC_COMMANDS_ON_STARTUP=true

# Development mode: copy the commands into ONE server, where they appear
# instantly, instead of registering globally. Requires GUILD_ID. Default: false.
#DEBUG=false

# The server (guild) used by DEBUG mode. Discord -> User Settings -> Advanced
# -> enable Developer Mode, then right-click the server icon -> Copy Server ID.
# Must be the numeric ID; leave it commented out unless DEBUG=true.
#GUILD_ID=

# ----------------------------------------------------------- game defaults --
# Each server can override these with /risky_set_min_game_time and
# /risky_set_max_games; the values here apply to servers that have not.

# Seconds a round must stay open before it can close, whether by the opener's
# Close button or by the player-threshold auto-close. /risky_start_no_ping
# skips the minimum for that round. Default: 1800 (30 minutes).
#DEFAULT_MIN_GAME_SECONDS=1800

# Open rounds allowed in one channel at a time. Default: 10.
#DEFAULT_MAX_GAMES_PER_CHANNEL=10

# Seconds a member must wait between /risky_start rounds that ping a role.
# Applies only where an admin has set a ping role — without one /risky_start
# notifies nobody, so there is nothing to limit. A start that is refused (full
# channel, missing permission) pings no one and doesn't count.
# /risky_start_no_ping is never limited. 0 turns this off. Default: 60.
#START_COOLDOWN_SECONDS=60

# ----------------------------------------------------------------- support --

# Invite link /support hands out. Leave unset if this copy has no support
# server; /support then says so instead of pointing at someone else's.
#SUPPORT_INVITE_URL=https://discord.gg/your-invite
